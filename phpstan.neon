includes:
	- phpstan-baseline.neon

parameters:
	level: 8

	paths:
		- src/Mantle/
		- mantle.php
		- phpstan/
		- tests/

	ignoreErrors:
		-
			identifier: staticMethod.resultUnused
		# Will be fixed in PHPStan soon.
		-
			identifier: function.alreadyNarrowedType
			paths:
				- src/Mantle/Support
				- src/Mantle/Testing
		-
			identifier: missingType.generics
			paths:
				- src/Mantle/Contracts
		-
			identifier: missingType.iterableValue
			paths:
				- src/Mantle/Contracts
				- src/Mantle/Facade
				- src/Mantle/Filesystem/Filesystem.php
				- src/Mantle/Filesystem/Filesystem_Adapter.php
				- src/Mantle/Testing
				- src/Mantle/Testkit
		-
			identifier: missingType.return
			paths:
				- src/Mantle/Contracts
				- src/Mantle/Testing/Concerns/Core_Shim.php
		-
			identifier: missingType.parameter
			paths:
				- **/autoload.php
				- src/Mantle/Filesystem/Filesystem_Adapter.php
		-
			message: "#implements generic interface ArrayAccess but does not specify its types#"
			paths:
				- src/Mantle/Testing
		- "#Unsafe usage of new static#"
		- "#PHPDoc tag @param references unknown parameter#"
		- "#interface ArrayAccess but does not specify#"
		- "#ReflectionClass does not specify its types#"
		- "#ReflectionAttribute does not specify its types#"
		- "#@return is not subtype of template type TKey#"
		- "#query of method wpdb::prepare#"
		-
			identifier: method.childReturnType
			paths:
				- src/Mantle/Http_Client/Pooled_Pending_Request.php
		-
			identifier: argument.type
			paths:
				- src/Mantle/Support/Collection.php
		-
			identifier: return.type
			paths:
				- src/Mantle/Support/Collection.php

	universalObjectCratesClasses:
		- Mantle\Database\Model\Meta\Model_Meta_Proxy
		- Mantle\Support\Higher_Order_Collection_Proxy
		- Mantle\Support\Higher_Order_When_Proxy

	scanFiles:
		- %rootDir%/../../php-stubs/wp-cli-stubs/wp-cli-stubs.php

	scanDirectories:
		- tests/fixtures/phpstan
		- %currentWorkingDirectory%/vendor/squizlabs/php_codesniffer/src

	excludePaths:
		analyseAndScan:
			- src/Mantle/Blocks
			- src/Mantle/Container/Bound_Method.php
			- src/Mantle/Database/Factory
			- src/Mantle/Framework/Console/Hook_Usage_Command.php
			- src/Mantle/Framework/Console/Generators
			- src/Mantle/Query_Monitor
			- src/Mantle/Queue/Providers/WordPress/Admin/Queue_Jobs_Table.php
			- src/Mantle/Queue/Providers/WordPress/Admin/Service_Provider.php
			- src/Mantle/Support/Enumerable.php
			- src/Mantle/Support/Traits/Conditionable.php
			- src/Mantle/Testing/Mock_Action.php
			- src/Mantle/Testing/install-wordpress.php
			- src/Mantle/Testing/preload.php
			- src/Mantle/Testing/wordpress-bootstrap.php
			- src/Mantle/**/vendor/**

			# Files that need to be fixed and re-added.
			- src/Mantle/Queue/Queue_Fake.php

		# Excluded from analysis only; tests/fixtures/phpstan still has to be scanned.
		analyse:
			# Test data, not test code.
			- tests/fixtures
			- tests/includes
			- tests/template-parts
			- tests/Console/hook-usage

			# Tests that still need to be fixed. Removed one group at a time.



services:
	-
		class: Mantle\Tests\PHPStan\Higher_Order_Proxy_Extension
		tags:
			- phpstan.broker.methodsClassReflectionExtension
	-
		class: Mantle\Tests\PHPStan\Faker_Provider_Extension
		tags:
			- phpstan.broker.methodsClassReflectionExtension
