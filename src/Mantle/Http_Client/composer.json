{
    "name": "mantle-framework/http-client",
    "description": "The Mantle Framework Http Client Package",
    "type": "library",
    "require": {
        "php": "^8.2",
        "alleyinteractive/wp-concurrent-remote-requests": "^1.0.2",
        "mantle-framework/cache": "^1.0",
        "mantle-framework/support": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Mantle\\Http_Client\\": "./"
        },
        "files": [
            "autoload.php"
        ]
    },
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Alley",
            "email": "mantle@alley.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "alleyinteractive/composer-wordpress-autoloader": false
        },
        "sort-packages": true
    }
}
